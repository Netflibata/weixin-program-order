<view class="container">
  <view wx:if="{{cart.length === 0}}" class="empty-cart text-center mt-20">
    购物车暂无商品
  </view>
  <view wx:else>
    <view wx:for="{{cart}}" wx:key="_id" class="cart-item">
      <image src="{{item.img}}" class="cart-img"></image>
      <view class="cart-info">
        <text>{{item.name}}</text>
        <text>¥{{item.price}} × {{item.num}}</text>
      </view>
      <view class="cart-num">
        <button bindtap="cutNum" data-id="{{item._id}}">-</button>
        <text>{{item.num}}</text>
        <button bindtap="addNum" data-id="{{item._id}}">+</button>
      </view>
    </view>
    <view class="checkout-bar">
      <text>合计：¥{{total}}</text>
      <button class="btn checkout-btn" bindtap="submitOrder">提交订单</button>
    </view>
  </view>
</view>