page {
  background: #f5f5f5;
  padding: 20rpx;
}
.title {
  font-size: 38rpx;
  color: #ff6700;
  text-align: center;
  margin-bottom: 30rpx;
}
.empty {
  text-align: center;
  margin-top: 150rpx;
  color: #999;
  font-size: 28rpx;
}
.order-item {
  background: #fff;
  padding: 25rpx;
  border-radius: 12rpx;
  margin-bottom: 20rpx;
}
.order-header {
  border-bottom: 1rpx solid #eee;
  padding-bottom: 10rpx;
  margin-bottom: 10rpx;
}
.order-header text {
  display: block;
  font-size: 26rpx;
  color: #444;
  margin: 4rpx 0;
}
.order-dishes {
  font-size: 28rpx;
  margin-bottom: 15rpx;
}
.tip-text {
  font-size: 24rpx;
  color: #aaa;
}