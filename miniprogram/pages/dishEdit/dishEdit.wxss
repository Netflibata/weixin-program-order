.upload-box {
  padding: 40rpx 30rpx;
}
.title {
  font-size: 38rpx;
  text-align: center;
  margin-bottom: 40rpx;
  color: #333;
}
.img-wrap {
  width: 300rpx;
  height: 300rpx;
  border: 1rpx dashed #ccc;
  border-radius: 10rpx;
  margin: 0 auto 30rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}
.preview-img {
  width: 100%;
  height: 100%;
  border-radius: 10rpx;
}
.tip {
  color: #999;
  font-size: 26rpx;
}
.input-item {
  border: 1rpx solid #ddd;
  border-radius: 8rpx;
  padding: 20rpx;
  margin-bottom: 25rpx;
  font-size: 30rpx;
}
.submit-btn {
  width: 100%;
  height: 80rpx;
  line-height: 80rpx;
  margin-top: 30rpx;
}