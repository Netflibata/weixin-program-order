<view class="wrap">
  <!-- 左侧分类标签栏 -->
  <view class="left-cate">
    <view class="cate-item {{activeCate == '全部' ? 'active' : ''}}" bindtap="changeCate" data-cate="全部">全部</view>
    <view wx:for="{{cateArr}}" wx:key="*this" class="cate-item {{activeCate == item ? 'active' : ''}}" bindtap="changeCate" data-cate="{{item}}">
      {{item}}
    </view>
  </view>

  <!-- 右侧菜品区域 -->
  <view class="right-dish">
    <view wx:if="{{filterDish.length == 0}}" class="no-dish">该分类暂无菜品</view>
    <view wx:for="{{filterDish}}" wx:key="_id" class="dish-item">
      <image src="{{item.img}}" class="dish-img"></image>
      <view class="dish-text">
        <text class="name">{{item.name}}</text>
        <text class="cate-tag">分类：{{item.category}}</text>
        <text class="price">¥{{item.price}}</text>
      </view>
      <button class="cart-btn btn" bindtap="addCart" data-id="{{item._id}}">加入购物车</button>
    </view>
  </view>
</view>